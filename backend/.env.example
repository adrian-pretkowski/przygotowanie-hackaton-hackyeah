# Local configuration template. Copy to backend/.env (.env is in .gitignore) and fill in.
#   cp .env.example .env
# Format: KEY=value, no quotes.

# Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional overrides of application.yml settings. Uncomment only the ones you change:
# an empty value overrides the default.
# VISION_MODEL=claude-sonnet-5-5
# VISION_EFFORT=low
# VISION_REFUSAL_FALLBACK=true
